{
  "info": {
    "name": "Document Q&A Assistant",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom (Collection Runner). The upload request expects Postman's working directory to be the project root so sample_pdfs/ is found; otherwise pick the file manually."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiKey",
      "value": "change-me-dev-key"
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "questionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health (no key)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ready",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ready",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ready"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('has llm flag', () => pm.expect(pm.response.json()).to.have.property('llm'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload PDF (REQUIRED endpoint)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "upload"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "sample_pdfs/Northwind_Leave_Policy.pdf"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 202', () => pm.response.to.have.status(202));",
              "const d = pm.response.json(); pm.collectionVariables.set('documentId', d.document_id);",
              "pm.test('has document id', () => pm.expect(d.document_id).to.match(/^DOC\\d{3,}$/));",
              "pm.test('accepted for background processing', () => pm.expect(['pending','processing','completed']).to.include(d.status));"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload same PDF again -> 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "upload"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "sample_pdfs/Northwind_Leave_Policy.pdf"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 409', () => pm.response.to.have.status(409));",
              "pm.test('duplicate error code', () => pm.expect(pm.response.json().error.code).to.eql('duplicate_document'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List documents (REQUIRED endpoint)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('has documents array', () => pm.expect(pm.response.json().documents).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get document status / progress",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('progress present', () => pm.expect(pm.response.json().progress).to.have.property('percent'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Summary + suggested questions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}",
            "summary"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ask (REQUIRED endpoint)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ask"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"How many days of annual leave do full-time employees get per year?\",\n  \"top_k\": 5,\n  \"document_ids\": [\n    \"{{documentId}}\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json(); pm.collectionVariables.set('questionId', r.question_id);",
              "pm.test('answered with citations', () => { pm.expect(r.answered).to.eql(true); pm.expect(r.citations.length).to.be.above(0); pm.expect(r.citations[0]).to.have.property('page'); });",
              "pm.test('answer mentions 24', () => pm.expect(r.answer).to.include('24'));",
              "pm.test('timings returned', () => pm.expect(r.timings).to.have.property('total_ms'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ask out-of-document question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ask"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is the company's stock price today?\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('says not available, no citations', () => { pm.expect(r.answered).to.eql(false); pm.expect(r.citations).to.have.lengthOf(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Ask (streaming, Server-Sent Events)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ask/stream",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ask",
            "stream"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"How long is maternity leave?\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('is event-stream', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'));",
              "pm.test('ends with a final event', () => pm.expect(pm.response.text()).to.include('event: final'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Page preview (PNG)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/pages/1/preview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}",
            "pages",
            "1",
            "preview"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('is PNG', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Feedback (thumbs up)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/feedback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "feedback"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question_id\": \"{{questionId}}\",\n  \"rating\": \"up\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Recent metrics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metrics/recent",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "metrics",
            "recent"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('latency block', () => pm.expect(pm.response.json()).to.have.property('latency_ms'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ask without API key -> 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ask"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"hello there\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ask with empty question -> 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ask"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));",
              "pm.test('no stack trace', () => pm.expect(pm.response.text()).to.not.include('Traceback'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown document -> 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents/DOC999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "DOC999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete document",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}