# Copy to .env and edit. Never commit .env (it is git-ignored).

# ---- security -------------------------------------------------------------
# Comma separated list of accepted API keys (sent as the X-API-Key header). CHANGE THIS.
API_KEYS=change-me-dev-key
# The Streamlit UI uses this key (run_all.py / docker compose copy the first API key automatically).
API_KEY=change-aman-dev-key
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---- models (Ollama) --------------------------------------------------------
LLM_BACKEND=ollama
EMBEDDER_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct
DEEP_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
NUM_CTX=4096
NUM_PREDICT=256

# ---- limits -----------------------------------------------------------------
MAX_FILE_MB=100
MAX_PAGES=1000
RATE_LIMIT_ASK_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=10

# ---- retrieval tuning (see README "Tuning") ----------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=100
CANDIDATES_K=30
FINAL_K=5
MIN_SIMILARITY=0.60
HNSW_EF_SEARCH=100
EMBED_BATCH_SIZE=64
RERANK_ENABLED=true
VERIFY_ENABLED=true
CONTEXT_TOKEN_BUDGET=3000

# ---- misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
DATA_DIR=data
